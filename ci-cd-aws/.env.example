# Copy to `.env` and fill in. Required at least for the `payments` service.
# Used by docker-compose.yml (images pushed to ECR by the CI/CD pipeline).

# Stripe (used by the Payments service at runtime)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Optional overrides for consuming pipeline-built images
# REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# IMAGE_TAG=abcdef123456

# Keycloak realm certs endpoint the gateway's resource server trusts
# KEYCLOAK_JWK_SET_URI=http://host.docker.internal:7080/realms/master/protocol/openid-connect/certs